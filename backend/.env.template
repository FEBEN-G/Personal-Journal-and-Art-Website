# MongoDB Connection String (from MongoDB Atlas)
# Format: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/my_journal?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://PLACEHOLDER_USER:PLACEHOLDER_PASS@cluster0.mongodb.net/my_journal

# Port for the Express server
PORT=5000

# JWT Secret for authentication
JWT_SECRET=your_super_secret_key_here
